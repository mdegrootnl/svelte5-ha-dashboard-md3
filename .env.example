DASHBOARD_DATA_DIR=./data
DASHBOARD_ORIGIN=http://localhost:3000
# Optional Docker host mapping for standalone server-side Home Assistant access.
# Example when HA is reachable by IP but homeassistant.local is not resolvable inside Docker:
# DASHBOARD_EXTRA_HOST=homeassistant.local:192.168.0.157
DASHBOARD_EXTRA_HOST=host.docker.internal:host-gateway
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
